}

function onDetalleFail() {
  document.getElementById('detalle-header').innerHTML =
    '<span style="color:var(--red)">Error de conexi\xF3n</span>' +
    '<button class="detalle-close" onclick="cerrarDetalle()"><svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>';
}

function cerrarDetalle(e) {
  if (e && e.target !== document.getElementById('detalle-overlay')) return;
  document.getElementById('detalle-overlay').classList.remove('abierto');
  document.body.style.overflow = '';
}

function cambiarTab(tab) {
  tabDetalle = tab;
  document.querySelectorAll('.det-tab').forEach(function(t){ t.classList.remove('activo'); });
  document.getElementById('tab-' + tab).classList.add('activo');
  renderizarTabDetalle(tab);
}

function renderizarTabDetalle(tab) {
  var d = puestoDetalle;
  if (!d) return;
  var body = document.getElementById('detalle-body');
  var pg   = d.puestoGenerico; // null si no tiene tipoPuesto

