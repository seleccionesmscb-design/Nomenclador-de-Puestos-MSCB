// PANEL DE DETALLE — lógica nueva cargo + puesto genérico
// ============================================================
function abrirDetalle(codigo, tipoRegistro, sinUrl) {
  document.getElementById('detalle-header').innerHTML =
    '<div style="display:flex;align-items:center;gap:12px;padding:4px 0">' +
    '<div class="spinner" style="width:24px;height:24px;border-width:2px"></div>' +
    '<span style="font-size:13px;color:var(--text2)">Cargando ficha...</span>' +
    '</div>' +
    '<button class="detalle-close" onclick="cerrarDetalle()"><svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>';
  document.getElementById('detalle-body').innerHTML = '';
  document.getElementById('detalle-tabs').style.display = 'none';
  document.getElementById('detalle-overlay').classList.add('abierto');
  document.body.style.overflow = 'hidden';

  google.script.run
    .withSuccessHandler(onDetalleLoaded)
    .withFailureHandler(onDetalleFail)
    .getDetallePuesto(codigo, tipoRegistro);
}

function onDetalleLoaded(resp) {
  if (!resp || !resp.ok) {
    document.getElementById('detalle-header').innerHTML =
      '<span style="color:var(--red)">Error al cargar</span>' +
      '<button class="detalle-close" onclick="cerrarDetalle()"><svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>';
    return;
  }
  var d = resp.datos;
  puestoDetalle = d;
  tabDetalle = 'descripcion';

  var nivel = d.nivel || '';
  var nc = NIVEL_CLASS[nivel] || 'dep';

  document.getElementById('detalle-header').innerHTML =
    '<div class="dh-icono ' + nc + '">' + (NIVEL_ICONS[nivel] || '<svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2h6a1 1 0 0 1 1 1v1H8V3a1 1 0 0 1 1-1z"/><rect x="5" y="4" width="14" height="18" rx="2"/><line x1="9" y1="11" x2="15" y2="11"/><line x1="9" y1="15" x2="15" y2="15"/></svg>') + '</div>' +
    '<div class="dh-info">' +
      '<div class="dh-nivel">' + nivel +
        (d.tipoPuesto ? ' &mdash; <span style="color:var(--accent);font-weight:700">' + d.tipoPuesto + '</span>' : '') +
      '</div>' +
      '<div class="dh-nombre">' + (d.nombreCargo || '') + '</div>' +
      '<div class="dh-codigo">' + (d.codigo || '') +
        '<button class="copy-btn" onclick="copiarCodigo(\'' + esc(d.codigo) + '\')" title="Copiar"><svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button>' +
        '<button class="copy-btn" onclick="copiarEnlace(\'' + esc(d.codigo) + '\')" title="Copiar enlace para compartir"><svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg></button>' +
        '<button class="copy-btn" onclick="imprimirFicha()" title="Imprimir / Exportar PDF"><svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></button>' +
      '</div>' +
    '</div>' +
    '<button class="detalle-close" onclick="cerrarDetalle()"><svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>';

  document.getElementById('detalle-tabs').style.display = 'flex';
  document.querySelectorAll('.det-tab').forEach(function(t){ t.classList.remove('activo'); });
  document.getElementById('tab-descripcion').classList.add('activo');
