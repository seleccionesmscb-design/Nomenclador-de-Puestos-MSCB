      '<div class="det-info-grid">' +
        detInfoItem('Tipo de Puesto', d.tipoPuesto || '\u2014') +
        detInfoItem('C\xF3digo Puesto', d.codigoPuesto || '\u2014', true) +
        detInfoItem('Normativa', d.normativa || '\u2014') +
        detInfoItem('Categor\xEDa', d.categoria || '\u2014') +
