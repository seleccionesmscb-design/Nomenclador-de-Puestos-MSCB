      '<button onclick="solicitarModificacion(\'' + esc(d.codigo) + '\')" style="' +
        'padding:11px 20px;background:var(--accent);color:#fff;border:none;border-radius:var(--r);' +
        'font-family:Segoe UI,sans-serif;font-size:12.5px;font-weight:600;cursor:pointer;' +
        'box-shadow:0 3px 10px rgba(45,107,228,.3);display:inline-flex;align-items:center;gap:8px">' +
        '<svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5z"/></svg> Solicitar modificaci\xF3n de este cargo' +
      '</button>' +
      '</div>';

    body.innerHTML = html;
  }
}

function detInfoItem(label, val, mono) {
  return '<div class="det-info-item">' +
    '<div class="dii-label">' + label + '</div>' +
    '<div class="dii-val' + (mono ? ' mono' : '') + '">' + (val || '\u2014') + '</div>' +
    '</div>';
}

function detReqItem(icon, label, cumple, detalle) {
  return '<div class="det-req-item ' + (cumple ? 'cumple' : 'no-cumple') + '">' +
    '<span class="dr-icon">' + icon + '</span>' +
    '<div>' +
      '<div style="font-weight:600;color:var(--text)">' + label + '</div>' +
      '<div style="font-size:11px;color:var(--text3);margin-top:2px">' + (detalle || '') + '</div>' +
    '</div>' +
    '<span class="dr-check">' + (cumple ? '<svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>' : '<svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/></svg>') + '</span>' +
    '</div>';
}

function copiarCodigo(codigo) {
  navigator.clipboard.writeText(codigo).then(function(){
    mostrarToast('C\xF3digo ' + codigo + ' copiado', false);
  });
}

function copiarEnlace(codigo) {
  // Se usa APP_URL (la URL pública real /exec, inyectada por el servidor) en vez de
  // window.location, porque la app corre en un iframe sandbox de GAS cuya URL interna
  // (googleusercontent.com) no es navegable ni compartible.
  var url = new URL(APP_URL);
  url.searchParams.set('cargo', codigo);
  if (puestoDetalle && puestoDetalle.tipoRegistro) url.searchParams.set('tipo', puestoDetalle.tipoRegistro);
  navigator.clipboard.writeText(url.toString()).then(function(){
    mostrarToast('Enlace copiado al portapapeles', false);
  });
}

function imprimirFicha() {
  if (!puestoDetalle) return;
  var savedTab = tabDetalle;
  var body = document.getElementById('detalle-body');
  var full = '';
  ['descripcion', 'info', 'requisitos', 'contexto'].forEach(function(t){
    renderizarTabDetalle(t);
    full += body.innerHTML;
  });
  renderizarTabDetalle(savedTab);
  document.querySelectorAll('.det-tab').forEach(function(t){ t.classList.remove('activo'); });
  document.getElementById('tab-' + savedTab).classList.add('activo');

  document.getElementById('detalle-print').innerHTML =
    '<div class="print-header">' +
      '<div class="print-nombre">' + (puestoDetalle.nombreCargo || '') + '</div>' +
      '<div class="print-meta">' + (puestoDetalle.codigo || '') + ' &middot; ' + (puestoDetalle.nivel || '') +
        (puestoDetalle.tipoPuesto ? ' &middot; ' + puestoDetalle.tipoPuesto : '') +
      '</div>' +
    '</div>' + full;
  window.print();
}

function solicitarModificacion(codigo) {
  cerrarDetalle();
  navegar('registro');
}

// ============================================================
// ÁREAS
// ============================================================
function renderizarAreas() {
  var secs = {};
  DATOS.forEach(function(d){
    var s = d.secretaria || 'Sin secretar\xEDa';
    if (!secs[s]) secs[s] = { nombre: s, dirs: 0, puestos: 0 };
    if (d.nivel === 'Direcci\xF3n') secs[s].dirs++;
    secs[s].puestos++;
  });
  var colores = ['#dbeafe','#ede9fe','#d1fae5','#fff7ed','#fce7f3','#fef3c7','#f0fdf4','#eff6ff'];
  var keys = Object.keys(secs);
  var grid = document.getElementById('areas-grid');
  grid.innerHTML = keys.map(function(k, i){
    var s = secs[k];
    var bg = colores[i % colores.length];
    var partes = k.split('\u2014');
    var nombre = partes[1] ? partes[1].trim() : k;
    var cod    = partes[0].trim();
    return '<div class="area-card" onclick="filtrarPorSecretaria(\'' + esc(k) + '\')">' +
      '<div class="area-card-header">' +
        '<div class="area-icon" style="background:' + bg + '"><svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="1"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="15" y2="16"/></svg></div>' +
        '<div><div class="ar-titulo">' + nombre + '</div><div class="ar-codigo">' + cod + '</div></div>' +
      '</div>' +
      '<div class="area-card-body"><div class="area-stat-row">' +
        '<div class="area-stat"><div class="as-num">' + s.puestos + '</div><div class="as-label">Cargos</div></div>' +
        '<div class="area-stat"><div class="as-num">' + s.dirs + '</div><div class="as-label">Direcciones</div></div>' +
      '</div></div>' +
      '</div>';
  }).join('');
}

function filtrarPorSecretaria(sec) {
  filtroSec = sec;
  navegar('nomenclador');
  setTimeout(function(){
    document.querySelectorAll('#filtro-sec .filtro-opt').forEach(function(o){
      o.classList.toggle('sel', o.dataset.val === sec);
    });
    renderizarNomenclador();
  }, 100);
}

// ============================================================
// CATEGORÍAS
// ============================================================
function renderizarCategorias() {
  var cat = {};
  DATOS.forEach(function(d){
    var o = d.tipoPuesto || d.orientacion || 'Sin clasificar';
    if (!cat[o]) cat[o] = [];
    cat[o].push(d);
  });
  var COLORS = ['#dbeafe','#d1fae5','#ede9fe','#fff7ed','#fce7f3','#fef3c7'];
  var ICONS  = ['<svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>','<svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>','<svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>','<svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>','<svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2h6a1 1 0 0 1 1 1v1H8V3a1 1 0 0 1 1-1z"/><rect x="5" y="4" width="14" height="18" rx="2"/><line x1="9" y1="11" x2="15" y2="11"/><line x1="9" y1="15" x2="15" y2="15"/></svg>','<svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41 13.42 20.59a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>'];
  var keys = Object.keys(cat).sort();
  var cont = document.getElementById('categorias-content');
  cont.innerHTML = keys.map(function(o, idx){
    var color = COLORS[idx % COLORS.length];
    var icon  = ICONS[idx % ICONS.length];
    return '<div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);margin-bottom:16px;overflow:hidden;box-shadow:var(--sh)">' +
      '<div style="padding:16px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px;background:' + color + '">' +
        '<span style="font-size:22px">' + icon + '</span>' +
        '<div>' +
          '<div style="font-size:14px;font-weight:700;color:var(--navy)">' + o + '</div>' +
          '<div style="font-size:11px;color:var(--text2)">' + cat[o].length + ' cargos en esta categor\xEDa</div>' +
        '</div>' +
      '</div>' +
      '<div style="padding:12px 16px;display:flex;flex-direction:column;gap:6px">' +
        cat[o].slice(0, 5).map(function(d){
          return '<div onclick="abrirDetalle(\'' + esc(d.codigo) + '\')" ' +
            'style="padding:8px 12px;border-radius:var(--r-sm);cursor:pointer;display:flex;align-items:center;gap:10px;transition:background .15s" ' +
            'onmouseover="this.style.background=\'var(--surface2)\'" onmouseout="this.style.background=\'\'">' +
            '<span style="font-family:Courier New,monospace;font-size:10px;color:var(--text3);min-width:80px">' + (d.codigo || '') + '</span>' +
            '<span style="font-size:12.5px;font-weight:600;color:var(--navy)">' + (d.nombreCargo || '') + '</span>' +
            '<span style="margin-left:auto;font-size:10px;color:var(--text3)">' + (d.nivel || '') + '</span>' +
            '</div>';
        }).join('') +
        (cat[o].length > 5 ? '<div style="font-size:11px;color:var(--text3);padding:6px 12px">+ ' + (cat[o].length - 5) + ' m\xE1s...</div>' : '') +
      '</div>' +
      '</div>';
  }).join('');
}

// ============================================================
// ORGANIGRAMA
// ============================================================
function toggleOrgExpand(ev, codigo) {
  ev.stopPropagation();
  orgExpandido[codigo] = true;
  renderizarOrganigrama();
}

function renderizarOrganigrama() {
  var area = document.getElementById('org-area');
  var filtroSecOrg = document.getElementById('org-filtro-sec').value;
  var dirs = DATOS.filter(function(d){
    return d.nivel === 'Direcci\xF3n' && (!filtroSecOrg || d.secretaria === filtroSecOrg);
  });
  if (dirs.length === 0) {
    area.innerHTML = '<div class="empty-state"><div class="es-icon"><svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></div><div class="es-title">Sin datos</div></div>';
    return;
  }
  var grupos = {};
  dirs.forEach(function(d){
    var s = d.secretaria || 'Sin secretar\xEDa';
    if (!grupos[s]) grupos[s] = [];
    grupos[s].push(d);
  });
  var html = '<div style="display:flex;flex-direction:column;gap:40px;width:100%">';
  Object.keys(grupos).forEach(function(s){
    var partes = s.split('\u2014');
    var nombre = partes[1] ? partes[1].trim() : s;
    var cod    = partes[0].trim();
    html += '<div style="display:flex;flex-direction:column;align-items:center">' +
        '<div class="org-node secretaria" style="min-width:180px;max-width:220px">' +
          '<span class="on-icono"><svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="1"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="15" y2="16"/></svg></span>' +
          '<div class="on-nombre">' + nombre + '</div>' +
          '<div class="on-codigo">C\xF3d. \xC1REA ' + cod + '</div>' +
        '</div>' +
      '<div class="org-stem-down"></div>' +
      '<div class="org-children">' +
        grupos[s].map(function(d){
          var subdeps = DATOS.filter(function(sub){
            return (sub.secretaria === d.secretaria)
              && (sub.nivel === 'Departamento' || sub.nivel === 'Divisi\xF3n')
              && String(sub.codigo).startsWith(String(d.codigo).substring(0, 10));
          });
          return '<div class="org-child">' +
            '<div class="org-stem-v"></div>' +
            '<div class="org-node direccion" onclick="abrirDetalle(\'' + esc(d.codigo) + '\')" title="' + (d.nombreCargo || '') + '">' +
              '<span class="on-icono"><svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="9" width="18" height="12" rx="1"/><path d="M9 9V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v4"/><line x1="9" y1="14" x2="9" y2="14.01"/><line x1="15" y1="14" x2="15" y2="14.01"/></svg></span>' +
              '<div class="on-nombre">' + (d.nombreCargo || '').replace('Direcci\xF3n de ', 'Dir. de ').substring(0, 24) + '</div>' +
              '<div class="on-codigo">' + (d.codigo || '') + '</div>' +
            '</div>' +
            (subdeps.length > 0 ?
              '<div class="org-stem-down"></div>' +
              '<div class="org-children">' +
                (orgExpandido[d.codigo] ? subdeps : subdeps.slice(0, 4)).map(function(sub){
                  return '<div class="org-child">' +
                    '<div class="org-stem-v"></div>' +
                    '<div class="org-node jefatura" onclick="abrirDetalle(\'' + esc(sub.codigo) + '\')" title="' + (sub.nombreCargo || '') + '" style="min-width:96px;max-width:124px">' +
                      '<div class="on-nombre" style="font-size:10px">' + (sub.nombreCargo || '').substring(0, 22) + '</div>' +
                      '<div class="on-codigo">' + (sub.codigo || '') + '</div>' +
                    '</div>' +
                  '</div>';
                }).join('') +
                (!orgExpandido[d.codigo] && subdeps.length > 4 ?
                  '<div class="org-child">' +
                    '<div class="org-stem-v"></div>' +
                    '<div class="org-node jefatura" onclick="toggleOrgExpand(event,\'' + esc(d.codigo) + '\')" style="font-size:10px;color:var(--accent);font-weight:700">+' + (subdeps.length - 4) + ' m\xE1s</div>' +
                  '</div>'
                : '') +
              '</div>'
            : '') +
            '</div>';
        }).join('') +
      '</div>' +
      '</div>';
  });
  html += '</div>';
  area.innerHTML = html;
}

// ============================================================
// EXPORTAR
// ============================================================
function exportarNomenclador() {
  var filtrados = datosFiltrados();
  var csv = 'C\xF3digo,Nombre del Cargo,Nivel,Tipo Puesto,Orientaci\xF3n,Secretar\xEDa,Requiere T\xEDtulo,Requiere Matr\xEDcula,Normativa\n';
  filtrados.forEach(function(d){
    csv += [
      d.codigo,
      '"' + (d.nombreCargo || '') + '"',
      d.nivel,
      '"' + (d.tipoPuesto || '') + '"',
      d.orientacion,
      '"' + (d.secretaria || '') + '"',
      d.requiereTitulo,
      d.requiereMatricula,
      d.normativa
    ].join(',') + '\n';
  });
  var blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
  var url = URL.createObjectURL(blob);
  var a = document.createElement('a');
  a.href = url; a.download = 'nomenclador-mscb.csv'; a.click();
  mostrarToast('CSV exportado <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>', false);
}

function exportarOrg() { mostrarToast('Pr\xF3ximamente: exportar organigrama como PDF', false); }

// ============================================================
// AYUDA
// ============================================================
function toggleAyuda() {
  mostrarToast('Ayuda: us\xE1 los filtros del panel izquierdo para explorar cargos. Hac\xE9 clic en cualquier cargo para ver su ficha completa.', false);
}

// ============================================================
// TOAST
// ============================================================
function mostrarToast(msg, esError) {
  var t = document.getElementById('toast');
  t.innerHTML = msg;
  t.className = 'visible' + (esError ? '' : ' ok');
  clearTimeout(t._to);
  t._to = setTimeout(function(){ t.className = ''; }, 4000);
}

// ============================================================
// UTILIDAD — escapa comillas simples para innerHTML onclick
// ============================================================
function esc(str) {
  return String(str || '').replace(/'/g, "\\'");
}
