<script>
// Datos inyectados por GAS en build-time
var DATOS_SERVIDOR = (function(){
  try { return JSON.parse('<?= datosInyectados ?>'); }
  catch(e){ return []; }
})();

// URL pública real de la app (la ventana sandbox de GAS no expone esta URL vía window.location)
var APP_URL = '<?= appUrl ?>';
var CARGO_INICIAL = (function(){
  try { return JSON.parse('<?= cargoInicial ?>'); } catch(e){ return ''; }
})();
var TIPO_INICIAL = (function(){
  try { return JSON.parse('<?= tipoInicial ?>'); } catch(e){ return ''; }
})();

// ============================================================
// CONFIGURACIÓN
// ============================================================
var REGISTRO_URL = 'https://script.google.com/macros/s/AKfycbxWnjdPzTp2DReiIySsqe6YCOkNRA1FC2baZSC5fyOShV6JDuKyvLnmALbZi0kgj7jw/exec?page=registro';
var DATOS_URL = '';

// ============================================================
// ESTADO GLOBAL
// ============================================================
var DATOS = [];
var filtroNivel = '';
var filtroOrient = '';
var filtroSec = '';
var terminoBusqueda = '';
var ordenActual = 'nombre';
var vistaActual = 'inicio';
var puestoDetalle = null;
var tabDetalle = 'descripcion';
var orgExpandido = {};

// ============================================================
// INIT
// ============================================================
document.addEventListener('DOMContentLoaded', function() {
  if (REGISTRO_URL) {
    document.getElementById('iframe-registro').src = REGISTRO_URL;
    document.getElementById('registro-placeholder').style.display = 'none';
  }
  google.script.run.withSuccessHandler(function(src){
    if (src) document.getElementById('sidebar-logo').src = src;
  }).getLogo();
  cargarDatos();
});

function cargarDatos() {
  if (DATOS_SERVIDOR && DATOS_SERVIDOR.length > 0) {
    DATOS = DATOS_SERVIDOR;
    inicializarUI();
  } else {
    google.script.run
      .withSuccessHandler(function(resp){
        DATOS = resp.ok ? resp.datos : [];
        inicializarUI();
      })
      .withFailureHandler(function(){
        DATOS = [];
        inicializarUI();
      })
      .getDatosNomenclador();
  }
}

function inicializarUI() {
  actualizarEstadisticas();
  poblarFiltroSecretarias();
  renderizarNomenclador();
  renderizarAreas();
  renderizarCategorias();
  renderizarOrganigrama();
  abrirDesdeUrl();
}

function abrirDesdeUrl() {
  // CARGO_INICIAL viene del servidor (doGet lee ?cargo=&tipo= de la URL real),
  // porque la app corre en un iframe sandbox cuya window.location no es la URL pública.
  if (CARGO_INICIAL) abrirDetalle(CARGO_INICIAL, TIPO_INICIAL || undefined, true);
}

// ============================================================
// ESTADÍSTICAS
// ============================================================
function actualizarEstadisticas() {
  var total = DATOS.length;
  var dirs  = DATOS.filter(function(d){ return d.nivel === 'Direcci\xF3n'; }).length;
  var secs  = new Set(DATOS.map(function(d){ return (d.secretaria || '').split('\u2014')[0].trim(); })).size;
  setText('stat-puestos', total);
  setText('stat-areas', secs);
  setText('stat-dirs', dirs);
  setText('badge-total', total);
  setText('ci-puestos', total);
  setText('ci-dirs', dirs);
  setText('ci-areas', secs);
  var niveles = {'Direcci\xF3n':'dir','Departamento':'dep','Divisi\xF3n':'div','Secci\xF3n':'sec'};
  Object.keys(niveles).forEach(function(n){
    var el = document.getElementById('cnt-nivel-' + niveles[n]);
    if (el) el.textContent = DATOS.filter(function(d){ return d.nivel === n; }).length;
  });
  var elNoJer = document.getElementById('cnt-nivel-nojer');
  if (elNoJer) elNoJer.textContent = DATOS.filter(function(d){ return d.nivel === 'No jer\xE1rquico'; }).length;
  var elT = document.getElementById('cnt-nivel-todos');
  if (elT) elT.textContent = total;
}

function setText(id, val) {
  var el = document.getElementById(id);
  if (el) el.textContent = val;
}

// ============================================================
// NAVEGACIÓN
// ============================================================
var BREADCRUMBS = {
  inicio:'Inicio', organigrama:'Organigrama', nomenclador:'Nomenclador',
  areas:'\xC1reas', categorias:'Categor\xEDas', documentacion:'Documentaci\xF3n',
  info:'Informaci\xF3n adicional', registro:'Solicitudes'
};

function navegar(vista) {
  if (vista === 'registro') {
    window.open('https://script.google.com/macros/s/AKfycbxz8LGTVnhcqLKNNGhH598OLnNtEJAe4oSyOBSTv4yoM_UQkXVNqWzK9RZt_tBVdv8c/exec', '_blank');
    return;
  }
  if (vistaActual === vista) return;
  document.getElementById('vista-' + vistaActual).classList.remove('activa');
  var navAnterior = document.getElementById('nav-' + vistaActual);
  if (navAnterior) navAnterior.classList.remove('active');
  vistaActual = vista;
  document.getElementById('vista-' + vista).classList.add('activa');
  var navNuevo = document.getElementById('nav-' + vista);
  if (navNuevo) navNuevo.classList.add('active');
  setText('breadcrumb-actual', BREADCRUMBS[vista] || vista);
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

// ============================================================
// NOMENCLADOR — FILTROS Y RENDER
// ============================================================
function poblarFiltroSecretarias() {
  var secs = [];
  DATOS.forEach(function(d){
    if (d.secretaria && secs.indexOf(d.secretaria) === -1) secs.push(d.secretaria);
  });
  secs.sort();
  var cont = document.getElementById('filtro-sec');
  cont.innerHTML = '<div class="filtro-opt sel" data-val="" onclick="aplicarFiltroSec(this)"><span class="fo-dot"></span> Todas</div>';
  secs.forEach(function(s){
    var partes = s.split('\u2014');
    var abrev = (partes[1] ? partes[1].trim() : s).replace('Sec. ', '').substring(0, 24);
    cont.innerHTML += '<div class="filtro-opt" data-val="' + esc(s) + '" onclick="aplicarFiltroSec(this)"><span class="fo-dot"></span> ' + abrev + '</div>';
  });
  var orgSel = document.getElementById('org-filtro-sec');
  secs.forEach(function(s){
    var opt = document.createElement('option');
    var partes = s.split('\u2014');
    opt.value = s;
    opt.textContent = partes[1] ? partes[1].trim() : s;
    orgSel.appendChild(opt);
  });
}

function datosFiltrados() {
  return DATOS.filter(function(d){
    if (filtroNivel  && d.nivel       !== filtroNivel)  return false;
    if (filtroOrient && d.orientacion !== filtroOrient) return false;
    if (filtroSec    && d.secretaria  !== filtroSec)    return false;
    if (terminoBusqueda) {
      var t = terminoBusqueda.toLowerCase();
      return (d.nombreCargo || '').toLowerCase().includes(t)
          || (d.codigo      || '').toLowerCase().includes(t)
          || (d.tipoPuesto  || '').toLowerCase().includes(t)
          || (d.secretaria  || '').toLowerCase().includes(t)
          || (d.misionEspecifica || '').toLowerCase().includes(t)
          || (d.misionGenerica   || '').toLowerCase().includes(t);
    }
    return true;
  }).sort(function(a, b){
    if (ordenActual === 'nombre')    return (a.nombreCargo || '').localeCompare(b.nombreCargo || '');
    if (ordenActual === 'codigo')    return (a.codigo      || '').localeCompare(b.codigo      || '');
    if (ordenActual === 'nivel') {
      var ord = ['Direcci\xF3n','Departamento','Divisi\xF3n','Secci\xF3n'];
      return ord.indexOf(a.nivel) - ord.indexOf(b.nivel);
    }
    if (ordenActual === 'secretaria') return (a.secretaria || '').localeCompare(b.secretaria || '');
    return 0;
  });
}

function aplicarFiltroNivel(el) {
  document.querySelectorAll('#filtro-nivel .filtro-opt').forEach(function(o){ o.classList.remove('sel'); });
  el.classList.add('sel'); filtroNivel = el.dataset.val; renderizarNomenclador();
}
function aplicarFiltroOrient(el) {
  document.querySelectorAll('#filtro-orient .filtro-opt').forEach(function(o){ o.classList.remove('sel'); });
  el.classList.add('sel'); filtroOrient = el.dataset.val; renderizarNomenclador();
}
function aplicarFiltroSec(el) {
  document.querySelectorAll('#filtro-sec .filtro-opt').forEach(function(o){ o.classList.remove('sel'); });
  el.classList.add('sel'); filtroSec = el.dataset.val; renderizarNomenclador();
}
function aplicarOrden(val) { ordenActual = val; renderizarNomenclador(); }
function buscarGlobal(val) {
  terminoBusqueda = val;
  if (val && vistaActual !== 'nomenclador') navegar('nomenclador');
  renderizarNomenclador();
}

var NIVEL_ICONS  = { 'Direcci\xF3n':'<svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="1"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="15" y2="16"/></svg>','Departamento':'<svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>','Divisi\xF3n':'<svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>','Secci\xF3n':'<svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>' };
var NIVEL_CLASS  = { 'Direcci\xF3n':'dir','Departamento':'dep','Divisi\xF3n':'div','Secci\xF3n':'sec' };
var ORIENT_CLASS = { 'Administrativa':'adm','Operativa':'ope','T\xE9cnica':'tec','Inspecci\xF3n':'ins' };

function renderizarNomenclador() {
  var lista = document.getElementById('nom-lista');
  var filtrados = datosFiltrados();
  setText('count-mostrados', filtrados.length);
  setText('count-total', DATOS.length);

  if (filtrados.length === 0) {
    lista.innerHTML = '<div class="empty-state"><div class="es-icon"><svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></div><div class="es-title">Sin resultados</div><div class="es-sub">Prob\xE1 con otros filtros o t\xE9rminos de b\xFAsqueda.</div></div>';
    return;
  }

  lista.innerHTML = filtrados.map(function(d){
    var nc = NIVEL_CLASS[d.nivel]  || 'dep';
    var oc = ORIENT_CLASS[d.orientacion] || 'adm';
    var secNombre = '';
    if (d.secretaria) {
      var partes = d.secretaria.split('\u2014');
      secNombre = partes[1] ? partes[1].trim() : d.secretaria;
    }
    // Para no jerárquicos usamos la dependencia como referencia de área
    var refArea = secNombre || d.secretaria || '';
    var esNoJer = d.tipoRegistro === 'nojerarquico';
    return '<div class="nom-card" onclick="abrirDetalle(\'' + esc(d.codigo) + '\', \'' + (d.tipoRegistro || 'jerarquico') + '\')" id="nc_' + esc(d.codigo) + '">' +
      '<div class="nc-nivel ' + nc + '">' + (esNoJer ? '<svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>' : (NIVEL_ICONS[d.nivel] || '<svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2h6a1 1 0 0 1 1 1v1H8V3a1 1 0 0 1 1-1z"/><rect x="5" y="4" width="14" height="18" rx="2"/><line x1="9" y1="11" x2="15" y2="11"/><line x1="9" y1="15" x2="15" y2="15"/></svg>')) + '</div>' +
      '<div class="nc-body">' +
        '<div class="nc-nombre">' + (d.nombreCargo || '') + '</div>' +
        '<div class="nc-meta">' +
          '<span class="nc-codigo">' + (esNoJer ? (d.tipoPuesto || 'No jer\xE1rquico') : (d.codigo || '')) + '</span>' +
          (refArea ? '<span class="nc-sec">&middot; ' + refArea + '</span>' : '') +
        '</div>' +
        '<div class="nc-tags">' +
          (esNoJer
            ? '<span class="nc-tag" style="background:#fce7f3;color:#831843"><svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg> No jer\xE1rquico</span>'
            : '<span class="nc-tag" style="background:var(--surface2);color:var(--text2);border:1px solid var(--border)">' + (d.nivel || '') + '</span>'
          ) +
          (d.tipoPuesto ? '<span class="nc-tag puesto"><svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2h6a1 1 0 0 1 1 1v1H8V3a1 1 0 0 1 1-1z"/><rect x="5" y="4" width="14" height="18" rx="2"/><line x1="9" y1="11" x2="15" y2="11"/><line x1="9" y1="15" x2="15" y2="15"/></svg> ' + d.tipoPuesto + '</span>' : '') +
          '<span class="nc-tag ' + oc + '">' + (d.orientacion || '') + '</span>' +
          (d.requiereTitulo === 'S\xED' ? '<span class="nc-tag" style="background:#fef3c7;color:#92400e"><svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"/></svg> T\xEDtulo</span>' : '') +
        '</div>' +
      '</div>' +
      '<div class="nc-right"><span class="nc-arrow">&#x203A;</span></div>' +
      '</div>';
  }).join('');
}

